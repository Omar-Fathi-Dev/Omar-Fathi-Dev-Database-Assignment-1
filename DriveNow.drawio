          <mxGeometry height="50" width="330" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-18" parent="1" style="swimlane;fontStyle=1;startSize=30;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="7.11 — Reservations" vertex="1">
          <mxGeometry height="80" width="330" x="730" y="780" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-19" parent="sYtfzVHAnJTOLgyBfKQ2-18" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Q13.&lt;/b&gt; Should the reservation channel (phone, branch, website) be stored?" vertex="1">
          <mxGeometry height="50" width="330" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-20" parent="1" style="swimlane;fontStyle=1;startSize=30;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="7.12 — Rentals" vertex="1">
          <mxGeometry height="130" width="330" x="1090" y="320" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-21" parent="sYtfzVHAnJTOLgyBfKQ2-20" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Q14.&lt;/b&gt; Can additional drivers be added only from the corporate authorized-driver list, or can any customer provide additional drivers?&lt;br&gt;&lt;b&gt;Q15.&lt;/b&gt; How is the late fee amount calculated?" vertex="1">
          <mxGeometry height="100" width="330" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-22" parent="1" style="swimlane;fontStyle=1;startSize=30;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="7.16 — Payments" vertex="1">
          <mxGeometry height="140" width="330" x="1090" y="470" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-23" parent="sYtfzVHAnJTOLgyBfKQ2-22" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Q16.&lt;/b&gt; How should monthly corporate invoices be represented?&lt;br&gt;&lt;b&gt;Q17.&lt;/b&gt; Can one monthly invoice cover multiple rentals?&lt;br&gt;&lt;b&gt;Q18.&lt;/b&gt; How should payments be allocated to corporate invoices?" vertex="1">
          <mxGeometry height="110" width="330" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-24" parent="1" style="swimlane;fontStyle=1;startSize=30;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="2. Assumptions" vertex="1">
          <mxGeometry height="240" width="330" x="1090" y="640" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-25" parent="sYtfzVHAnJTOLgyBfKQ2-24" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;7.1:&lt;/b&gt; Store only the current branch manager and TakeoverDate.&lt;br&gt;&lt;b&gt;7.1:&lt;/b&gt; Use Is24Hours; OpeningTime and ClosingTime are NULL for 24/7 branches.&lt;br&gt;&lt;b&gt;7.4:&lt;/b&gt; ChargeAtRental stores the unit price at the time of rental.&lt;div&gt;&lt;strong&gt;7.12 &lt;/strong&gt;&amp;nbsp;An extension creates a new RENTAL record that references the previous rental through a 1:1 recursive foreign key (ParentRentalNo), forming an audit chain of extensions.&lt;/div&gt;&lt;div&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;7.14 &lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Damage reports are identified by (RentalNo, ReportNo) as a weak entity, with photo links stored in a separate multivalued table (DAMAGE_PHOTO).&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="330" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-26" parent="1" style="swimlane;fontStyle=1;startSize=30;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" value="3. Contradictions" vertex="1">
          <mxGeometry height="200" width="330" x="720" y="880" as="geometry" />
        </mxCell>
        <mxCell id="sYtfzVHAnJTOLgyBfKQ2-27" parent="sYtfzVHAnJTOLgyBfKQ2-26" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="&lt;p&gt;&lt;strong&gt;Section 7.7 + Stakeholder Interview Notes&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Section 7.7 states that corporate authorized drivers are only known through their company. However, the stakeholder interview says that some corporate drivers can also be individual customers.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Clarification needed:&lt;/strong&gt; Can the same person have both an Authorized Driver record and an Individual Customer record?&lt;/p&gt;" vertex="1">
          <mxGeometry height="40" width="330" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
