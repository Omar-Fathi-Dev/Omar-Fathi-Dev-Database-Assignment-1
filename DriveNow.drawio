        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n    %% Entities\n    BRANCH[BRANCH]\n    EMPLOYEE[EMPLOYEE]\n    COURSE[TRAINING_COURSE]\n\n    %% Branch attributes\n    BC([\&quot;BranchCode (PK)\&quot;])\n    BN([\&quot;BranchName\&quot;])\n    OH([\&quot;OpeningHours\&quot;])\n    CH([\&quot;ClosingHours\&quot;])\n    AIR([\&quot;IsAirportBranch\&quot;])\n    ADDR([\&quot;Address (Composite)\&quot;])\n    STREET([\&quot;Street\&quot;])\n    CITY([\&quot;City\&quot;])\n    GOV([\&quot;Governorate\&quot;])\n    PHONES([\&quot;PhoneNumbers (Multivalued)\&quot;])\n\n    BRANCH --- BC\n    BRANCH --- BN\n    BRANCH --- OH\n    BRANCH --- CH\n    BRANCH --- AIR\n    BRANCH --- ADDR\n    ADDR --- STREET\n    ADDR --- CITY\n    ADDR --- GOV\n    BRANCH --- PHONES\n\n    %% Employee attributes\n    EID([\&quot;EmployeeID (PK)\&quot;])\n    NID([\&quot;NationalID (Unique, 14 digits)\&quot;])\n    NAME([\&quot;Name (Composite)\&quot;])\n    FIRST([\&quot;FirstName\&quot;])\n    MIDDLE([\&quot;MiddleName\&quot;])\n    LAST([\&quot;LastName\&quot;])\n    DOB([\&quot;DateOfBirth\&quot;])\n    AGE([\&quot;Age (Derived)\&quot;])\n    HIRED([\&quot;HireDate\&quot;])\n    SALARY([\&quot;Salary\&quot;])\n    EMAIL([\&quot;Email\&quot;])\n\n    EMPLOYEE --- EID\n    EMPLOYEE --- NID\n    EMPLOYEE --- NAME\n    NAME --- FIRST\n    NAME --- MIDDLE\n    NAME --- LAST\n    EMPLOYEE --- DOB\n    DOB -.-&gt; AGE\n    EMPLOYEE --- HIRED\n    EMPLOYEE --- SALARY\n    EMPLOYEE --- EMAIL\n\n    %% Specialization\n    ISA{{\&quot;ISA - Disjoint\&quot;}}\n    AGENT[RENTAL_AGENT]\n    MECHANIC[MECHANIC]\n    OTHER[OTHER_STAFF]\n\n    EMPLOYEE --- ISA\n    ISA --- AGENT\n    ISA --- MECHANIC\n    ISA --- OTHER\n\n    COMM([\&quot;CommissionRate (max 15%)\&quot;])\n    SPEC([\&quot;Specialization\&quot;])\n    CERT([\&quot;CertificationLevel (1-5)\&quot;])\n\n    AGENT --- COMM\n    MECHANIC --- SPEC\n    MECHANIC --- CERT\n\n    %% Training course attributes\n    CC([\&quot;CourseCode (PK)\&quot;])\n    TITLE([\&quot;Title\&quot;])\n    HOURS([\&quot;Hours\&quot;])\n    MANDATORY([\&quot;IsMandatory\&quot;])\n\n    COURSE --- CC\n    COURSE --- TITLE\n    COURSE --- HOURS\n    COURSE --- MANDATORY\n\n    %% Relationships\n    MANAGES{\&quot;MANAGES\&quot;}\n    ASSIGNED{\&quot;ASSIGNED_TO\&quot;}\n    SUPERVISES{\&quot;SUPERVISES\&quot;}\n    ENROLLED{\&quot;ENROLLED_IN\&quot;}\n\n    EMPLOYEE --- MANAGES\n    MANAGES --- BRANCH\n\n    ASSIGNED --- EMPLOYEE\n    ASSIGNED --- BRANCH\n\n    EMPLOYEE --- SUPERVISES\n    SUPERVISES --- EMPLOYEE\n\n    EMPLOYEE --- ENROLLED\n    ENROLLED --- COURSE\n\n    %% Relationship attributes\n    ADATE([\&quot;AssignedDate\&quot;])\n    MANAGES --- ADATE\n\n    ED([\&quot;EnrollmentDate\&quot;])\n    CD([\&quot;CompletionDate\&quot;])\n    SCORE([\&quot;Score\&quot;])\n    STATUS([\&quot;Status: Pass/Fail\&quot;])\n    ATTEMPT([\&quot;AttemptNumber\&quot;])\n\n    ENROLLED --- ED\n    ENROLLED --- CD\n    ENROLLED --- SCORE\n    ENROLLED --- STATUS\n    ENROLLED --- ATTEMPT\n\n    %% Relationship labels\n    BRANCH ---|\&quot;1\&quot;| MANAGES\n    EMPLOYEE ---|\&quot;1\&quot;| MANAGES\n\n    BRANCH ---|\&quot;1\&quot;| ASSIGNED\n    EMPLOYEE ---|\&quot;N\&quot;| ASSIGNED\n\n    EMPLOYEE ---|\&quot;1 : N (recursive)\&quot;| SUPERVISES\n    EMPLOYEE ---|\&quot;M : N\&quot;| ENROLLED\n\n    classDef entity fill:#dbeafe,stroke:#2563eb,color:#111827,stroke-width:2px\n    classDef attribute fill:#ffffff,stroke:#64748b,color:#111827\n    classDef relationship fill:#fef3c7,stroke:#b45309,color:#111827\n    class BRANCH,EMPLOYEE,COURSE,AGENT,MECHANIC,OTHER entity\n    class BC,BN,OH,CH,AIR,ADDR,STREET,CITY,GOV,PHONES,EID,NID,NAME,FIRST,MIDDLE,LAST,DOB,AGE,HIRED,SALARY,EMAIL,COMM,SPEC,CERT,CC,TITLE,HOURS,MANDATORY,ADATE,ED,CD,SCORE,STATUS,ATTEMPT attribute\n    class MANAGES,ASSIGNED,SUPERVISES,ENROLLED relationship\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v_9Zua8LsARrO0SMw_1b-131">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
